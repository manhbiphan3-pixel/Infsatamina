--[[
  SCRIPT: Inf Stamina (Không Menu - Hiện thông báo thành công)
]]--

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local LocalPlayer = Players.LocalPlayer

-- Hiển thị thông báo góc màn hình khi bật thành công
pcall(function()
    StarterGui:SetCore("SendNotification", {
        Title = "⚡ Inf Stamina",
        Text = "Đã bật Thể Lực Vô Hạn thành công!",
        Duration = 3
    })
end)

local staminaKeywords = {"stamina", "energy", "sprint", "endurance", "run", "dash", "fatigue", "stam", "staminavalue"}

local function checkAndFill(parent)
    if not parent then return end
    for _, v in pairs(parent:GetDescendants()) do
        if v:IsA("NumberValue") or v:IsA("IntValue") then
            local n = string.lower(v.Name)
            for _, kw in pairs(staminaKeywords) do
                if string.find(n, kw) then 
                    v.Value = 100 
                    break 
                end
            end
        end
    end
    if parent:IsA("Model") then
        for name, val in pairs(parent:GetAttributes()) do
            local n = string.lower(name)
            for _, kw in pairs(staminaKeywords) do
                if string.find(n, kw) and type(val) == "number" then 
                    parent:SetAttribute(name, 100) 
                    break 
                end
            end
        end
    end
end

-- Vòng lặp chạy ngầm giữ thể lực đầy (Quét cả Character lẫn PlayerGui)
RunService.Heartbeat:Connect(function()
    checkAndFill(LocalPlayer.Character)
    checkAndFill(LocalPlayer:FindFirstChild("PlayerGui"))
end)
